# Example environment configuration for GlobyEdu backend.
# Keep this file free of real secrets. Copy it to .env and fill in the actual values.
# This template matches the environment variables currently used by the backend code.

# Runtime environment
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# App URL
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Legacy database / Prisma compatibility path. Keep isolated during Firebase migration.
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Production data direction. Set this to firebase for Firestore/Storage adapters.
DATA_STORE_MODE=firebase

# Supabase is development-only compatibility storage and must not be configured in production.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Authentication / tokens
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_SALT_ROUNDS=12
EMAIL_TOKEN_MINUTES=60
DEV_SUPER_ADMIN_PASSWORD=replace_for_local_dev_only

# Firebase web configuration (public config exposed by the backend)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin service account (backend only)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend contact form configuration
# RESEND_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=GlobyEdu <hello@your-verified-domain.com>
CONTACT_EMAIL=your-inbox@example.com

