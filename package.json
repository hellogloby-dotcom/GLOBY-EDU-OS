{
  "name": "globyedu-os",
  "private": true,
  "version": "0.1.0",
  "description": "GlobyEdu OS - The Operating System for Modern Schools (monorepo scaffold)",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "node scripts/build-production.js",
    "build:marketing-css": "npx @tailwindcss/cli -i ./frontend/marketing/src/styles.css -o ./frontend/marketing/src/styles.generated.css --config ./frontend/marketing/tailwind.config.js",
    "dev": "concurrently \"npm --prefix backend run dev\"",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest --passWithNoTests"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "postcss": "^8.5.25",
    "prettier": "^2.0.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0"
  }
}
