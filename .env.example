# Shared development environment example. Do not put credentials in this file.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATA_STORE_MODE=firebase

# Legacy Prisma/PostgreSQL compatibility variables. Firebase is the production direction.
DATABASE_URL=
DIRECT_URL=

# Production CORS/API configuration.
API_URL=
CORS_ORIGINS=

# Backend secrets. Generate and provision outside source control.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public Firebase web configuration may be empty when Firebase is disabled.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin service account (backend only; never expose to the browser).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 object storage (optional alternative to Firebase/Supabase)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=globyedu-school-files
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Brevo transactional email configuration (server-side only)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@your-verified-domain.com
BREVO_SENDER_NAME=GlobyEdu

# Paystack payment configuration (backend-authoritative; never expose secret values to the browser).
APP_URL=http://localhost:4000
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=

# Legacy Prisma/PostgreSQL compatibility variables. Keep empty for Firebase mode.
DATABASE_URL=
DIRECT_URL=

# Supabase is not a production provider. Keep these unset during migration.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional local file compatibility settings.
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# Optional integrations.
AI_PROVIDER=openai
AI_API_KEY=
SENTRY_DSN=

# Do not commit real secrets. Use a secrets manager for production.
